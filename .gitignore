node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ==============================================================================
# BUILD & COMPILATION OUTPUTS
# ==============================================================================
dist/
build/
out/
*.tsbuildinfo
.eslintcache
.cache/
deploy/dist/
deploy/node_modules/

# Compiled frontend assets (regenerated automatically via npm run build)
backend/public/assets/
deploy/public/assets/
**/public/assets/
*.map

# ==============================================================================
# CRAWLED MEDIA & DYNAMIC AVATARS (Heavy binary assets ~30MB+)
# ==============================================================================
**/avatars/
backend/data/avatars/
deploy/data/avatars/
deploy/avatars/
data/avatars/
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.mp4
*.webm
!frontend/src/assets/**

# ==============================================================================
# RUNTIME DATA & STORAGE (Databases & Crawled state)
# ==============================================================================
*.sqlite
*.sqlite-*
*.db
*.db-*
*.sqlite3
*.sqlite3-*
videos_data*.json
profiles_data*.json
deploy/videos_data*.json
deploy/profiles_data*.json
output.csv
output.json
deploy/output.csv
deploy/output.json

# ==============================================================================
# ENVIRONMENT & SENSITIVE CREDENTIALS
# ==============================================================================
.env
.env.*
!.env.example
*.env
cookies.json
*cookies*.json
!*.example
*.pem
*.key

# ==============================================================================
# TEST & SCRATCH / DEBUG ARTIFACTS
# ==============================================================================
scratch/
test/
test_*/
test-results/
playwright-report/
playwright/.cache/
blob-report/
.playwright/
pw-browsers/
*.dump
*.har
*.tmp
*.temp
*.bak

# ==============================================================================
# PYTHON (Artifacts & Environments)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.class
.venv/
venv/
env/
ENV/

# ==============================================================================
# LOGS
# ==============================================================================
logs/
*.log

# ==============================================================================
